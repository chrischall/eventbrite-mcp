# Personal OAuth token for the documented Eventbrite API
# (create one at https://www.eventbrite.com/platform/api-keys).
# Account/organizer tools need it; discovery tools use the browser bridge instead.
EVENTBRITE_TOKEN=your_private_token_here

# Optional: override the fetchproxy concentrator port (fleet default 37149).
# EVENTBRITE_WS_PORT=37149
